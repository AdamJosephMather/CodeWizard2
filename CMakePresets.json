{
  "version": 3,
  "cmakeMinimumRequired": {
	"major": 3,
	"minor": 21,
	"patch": 0
  },
  "configurePresets": [
	{
	  "name": "default",
	  "hidden": true,
	  "generator": "Ninja",
	  "toolchainFile": "D:/Users/adamj/Documents/C/vcpkg/scripts/buildsystems/vcpkg.cmake"
	},
	{
	  "name": "windows-release",
	  "inherits": "default",
	  "description": "Release build using vcpkg on Windows",
	  "binaryDir": "${sourceDir}/build/windows-release",
	  "cacheVariables": {
		"CMAKE_BUILD_TYPE": "Release",
		"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
		"VCPKG_TARGET_TRIPLET": "x64-windows"
	  }
	},
	{
		"name": "windows-asan",
		"inherits": "default",
		"description": "ASan build using vcpkg on Windows",
		"binaryDir": "${sourceDir}/build/windows-asan",
		"cacheVariables": {
			"CMAKE_BUILD_TYPE": "RelWithDebInfo",
			"CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
			"VCPKG_TARGET_TRIPLET": "x64-windows"
		}
	}
  ],
  "buildPresets": [
	{
	  "name": "windows-release",
	  "configurePreset": "windows-release"
	},
	{
		"name": "windows-asan",
		"configurePreset": "windows-asan"
	}
  ]
}
